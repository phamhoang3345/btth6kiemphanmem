            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code là 422 khi trùng Email\", function () {\r\n    pm.response.to.have.status(422);\r\n});\r\n\r\npm.test(\"Thông báo lỗi email đã tồn tại\", function () {\r\n    var jsonData = pm.response.json();\r\n    // Kiểm tra xem phản hồi trả về có chứa thông báo lỗi email không\r\n    var errorString = JSON.stringify(jsonData);\r\n    pm.expect(errorString).to.include(\"has already been taken\");\r\n});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\n// Pre-request: Tạo lại user với email {{userEmail}} để đảm bảo email tồn tại trong DB\n// Sau đó request này sẽ POST với cùng email đó → expect 422\nconst userEmail = pm.environment.get(\"userEmail\");\nconst token = pm.environment.get(\"token\");\n\npm.sendRequest({\n    url: \"https://gorest.co.in/public/v2/users\",\n    method: \"POST\",\n    header: {\n        \"Content-Type\": \"application/json\",\n        \"Authorization\": \"Bearer \" + token\n    },\n    body: {\n        mode: \"raw\",\n        raw: JSON.stringify({\n            name: \"Temp User For Duplicate Test\",\n            gender: \"male\",\n            email: userEmail,\n            status: \"active\"\n        })\n    }\n}, function (err, res) {\n    if (err) {\n        console.log(\"Pre-request error:\", err);\n    } else {\n        console.log(\"Pre-request: Created temp user with status\", res.code);\n        if (res.code === 201) {\n            const json = res.json();\n            pm.environment.set(\"tempUserId\", json.id);\n        }\n    }\n});\n"
                ]
              }
            }
